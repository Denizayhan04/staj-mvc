@using staj_mvc.Dto
@model staj_mvc.Models.ParseSonuc

@{
    ViewData["Title"] = L["DosyaYukle"];
}

<h2>@L["DosyaYukleBaslik"]</h2>

@if (ViewBag.Hata != null)
{
    <div class="alert alert-danger">@ViewBag.Hata</div>
}

<form asp-action="Index" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label">@L["SensorDosyasi"]</label>
        <input type="file" name="dosya" accept=".txt" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">@L["YukleParsEt"]</button>
    <a asp-action="LogGoster" class="btn btn-secondary ms-2">@L["LogDosyasiniGor"]</a>
</form>

@if (ViewBag.DosyaAdi != null)
{
    <hr class="my-4" />
    <p class="text-muted">@L["YuklenenDosya"]: <strong>@ViewBag.DosyaAdi</strong></p>

    @await Html.PartialAsync("~/Views/Parse/_GecerliTable.cshtml", Model.Gecerliler)
    <hr class="my-3" />
    @await Html.PartialAsync("~/Views/Parse/_HataliList.cshtml", Model.Hataliler)
}

@model staj_mvc.Models.ParseSonuc

@{
    ViewData["Title"] = L["HamVeriParse"];
}

<h2>@L["HamVeriParseBaslik"]</h2>
<p class="text-muted">Format: <code>Id,Tarih,Deger,Aciklama</code></p>

<form asp-action="Index" method="post">
    <div class="mb-3">
        <label class="form-label">@L["HamVeri"]</label>
        <textarea name="HamVeri" class="form-control font-monospace" rows="8"
                  placeholder="1,2024-01-15,150,Sensör A&#10;2,2024-01-16,200,Sensör B">@Model.HamVeri</textarea>
    </div>
    <button type="submit" class="btn btn-primary">@L["ParseEt"]</button>
</form>

@if (Model.Gecerliler.Any() || Model.Hataliler.Any())
{
    <hr class="my-4" />
    @await Html.PartialAsync("_GecerliTable", Model.Gecerliler)
    <hr class="my-3" />
    @await Html.PartialAsync("_HataliList", Model.Hataliler)
}
